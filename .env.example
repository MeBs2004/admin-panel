# Nuformly admin panel — environment variables.
# Copy to .env and fill in real values. Never commit .env.

# Base URL of the backend's admin API (e.g. https://api.yourdomain.com/api/admin)
VITE_API_URL=http://localhost:4002/api/admin

# Where the embeddable widget.js is served (default: the live widget CDN).
# For local development: http://localhost:5173
VITE_WIDGET_URL=https://chatbot-frontend-nine-psi.vercel.app
